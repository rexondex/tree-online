{
  "name": "online-rpg",
  "version": "1.0.0",
  "description": "Online multiplayer RPG prototype",
  "main": "electron/main.cjs",
  "scripts": {
    "server": "tsx server/index.ts",
    "dev": "vite",
    "client": "electron .",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "package": "npm run build && electron-builder --win --dir"
  },
  "keywords": [],
  "author": "",
  "type": "module",
  "dependencies": {
    "@electric-sql/pglite": "^0.5.17",
    "dotenv": "^18.0.10",
    "pg": "^8.23.1",
    "three": "^0.187.0",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/three": "^0.187.0",
    "@types/ws": "^8.18.2",
    "concurrently": "^10.0.7",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "private": true,
  "build": {
    "appId": "com.example.onlinerpg",
    "productName": "Online RPG",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/client/**",
      "electron/**",
      "package.json"
    ]
  }
}
